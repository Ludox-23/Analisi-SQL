SELECT count(*)

FROM exchange_rates

where rate is null;


</sql><sql name="SQL 7*">
--Analisi date (anno e mese ) con rate null
SELECT count(*), strftime('%Y-%m', date) as mese
 
FROM exchange_rates

where rate is null
group by mese
order by mese ;
 


</sql><sql name="SQL 9*">--Analisi mesi con rate null
SELECT count(*), strftime('%m', date) as mese
 
FROM exchange_rates

where rate is null
group by mese
order by mese ;
 
 
 </sql><current_tab id="2"/></tab_sql></sqlb_project>
